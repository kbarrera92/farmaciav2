{
  "ConnectionStrings": {
    "Pharmacy": ""
  },
  "Jwt": {
    "Issuer": "Pharmacy.Api",
    "Audience": "Pharmacy.Web",
    "Key": "",
    "ExpirationMinutes": 480,
    "CookieName": "pharmacy_auth"
  },
  "Security": {
    "Lockout": {
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 15
    },
    "Password": {
      "MinLength": 8,
      "RequireLetter": true,
      "RequireDigit": true
    },
    "LoginRateLimit": {
      "PermitLimit": 10
    }
  },
  "InitialAdmin": {
    "Username": "admin",
    "FullName": "Administrador",
    "Password": "",
    "BranchName": "Sucursal principal",
    "BranchAddress": "Pendiente de configurar"
  },
  "Database": {
    "SeedOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
